FROM debian:trixie-slim

ARG TIME_ZONE=Pacific/Auckland

# Every PHP version in this image. All of them are end of life, so PHP itself gets no security fixes any
# more, but the deb.sury.org builds on a current Debian keep the OS layer and the extensions patched.
# A container picks one version when it starts, see select-version.sh and entrypoint.sh.
ENV PHP_VERSIONS="7.2 7.3 7.4 8.0 8.1"

# apt does not retry failed downloads, so a single timed out .deb from the Debian CDN fails
# the whole build. Older suites go cold in the CDN more often, but any suite can time out.
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries

# PHP comes from deb.sury.org, the SQL Server ODBC driver and tools from Microsoft. Both repos are
# verified by their own keyring rather than the system-wide apt-key store. The Debian 13 repo is signed
# by Microsoft's 2025 key, the older microsoft.asc key does not verify it.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        ca-certificates \
        curl \
        gnupg2 \
    && curl -fsSL https://packages.sury.org/php/apt.gpg -o /usr/share/keyrings/deb.sury.org-php.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ trixie main' \
        > /etc/apt/sources.list.d/php.list \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft-2025.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/13/prod.list -o /etc/apt/sources.list.d/mssql-release.list

# The same extensions for every version, then the ones that only some versions have: json is part of PHP 8,
# xmlrpc left PHP 8, excimer and pspell were only ever added to 8.1.
RUN apt-get update \
    && packages='' \
    && for version in $PHP_VERSIONS; do \
        for extension in cli fpm dev curl gd igbinary intl ldap mbstring memcached mysql opcache pcov pgsql readline redis soap sqlite3 xdebug xhprof xml zip; do \
            packages="$packages php$version-$extension"; \
        done; \
    done \
    && ACCEPT_EULA=Y DEBIAN_FRONTEND=noninteractive apt-get install -y $packages \
        php7.2-json \
        php7.3-json \
        php7.4-json \
        php7.2-xmlrpc \
        php7.3-xmlrpc \
        php7.4-xmlrpc \
        php8.1-excimer \
        php8.1-pspell \
        php-pear \
        build-essential \
        unixodbc-dev \
        msodbcsql18 \
        mssql-tools18 \
        cron \
        nano \
        vim \
        wget \
        openssl \
        locales \
        tzdata \
        git \
        zip \
        netcat-traditional \
        bc \
        ghostscript \
        graphviz \
        aspell \
        xmlstarlet \
    && rm -rf /var/lib/apt/lists/*

# sqlsrv 5.8 and 5.9, the last releases for PHP 7.2 and 7.3, only know ODBC Driver 17, which Microsoft
# ships for amd64 only. On arm64 those two versions load sqlsrv but cannot connect to SQL Server.
RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        apt-get update \
        && ACCEPT_EULA=Y DEBIAN_FRONTEND=noninteractive apt-get install -y msodbcsql17 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY select-version.sh /usr/local/bin/totara-php-select
COPY pecl-install.sh /usr/local/bin/totara-pecl-install
RUN chmod +x /usr/local/bin/totara-php-select /usr/local/bin/totara-pecl-install

# Our php.ini replaces Debian's for both SAPIs, so the effective settings match the images built on the
# official php image, which ships no php.ini. The fpm drop-ins reproduce the official image's fpm setup,
# minus the two log directives PHP 7.3 introduced for 7.2.
COPY config/php.ini config/fpm.conf config/fpm-debian.conf /usr/local/share/totara-php/
RUN for version in $PHP_VERSIONS; do \
        cp /usr/local/share/totara-php/php.ini "/etc/php/$version/cli/php.ini" \
        && cp /usr/local/share/totara-php/php.ini "/etc/php/$version/fpm/php.ini" \
        && cp /usr/local/share/totara-php/fpm-debian.conf "/etc/php/$version/fpm/pool.d/zz-docker.conf" \
        && cp /usr/local/share/totara-php/fpm.conf "/etc/php/$version/fpm/pool.d/zz-totara.conf" \
        && if [ "$version" = 7.2 ]; then \
            sed -i -E '/^(log_limit|decorate_workers_output) /d' "/etc/php/$version/fpm/pool.d/zz-docker.conf"; \
        fi \
        && echo "xhprof.output_dir = /tmp/xhprof" >> "/etc/php/$version/mods-available/xhprof.ini" \
        || exit 1; \
    done

# sqlsrv and pdo_sqlsrv are not packaged, so they are built with pecl against each version. 5.9 dropped
# PHP 7.2 and 5.10 dropped 7.3, so each version gets the last release that supports it.
# The configure scripts generated by the PHP 7.x build system under trixie's autoconf use $SED before
# they define it, which silently drops the extension's own include paths, so SED is set up front. pecl
# keeps one registry for every version, so each build is deregistered, keeping its files, for the next.
RUN export SED=/bin/sed \
    && for version in $PHP_VERSIONS; do \
        case "$version" in \
            7.2) sqlsrv=5.8.1 ;; \
            7.3) sqlsrv=5.9.0 ;; \
            *) sqlsrv=5.10.1 ;; \
        esac \
        && totara-php-select "$version" \
        && totara-pecl-install "sqlsrv-$sqlsrv" "pdo_sqlsrv-$sqlsrv" \
        && pecl uninstall --register-only pecl/sqlsrv pecl/pdo_sqlsrv \
        && rm -rf /tmp/pear \
        && echo 'extension=sqlsrv.so' > "/etc/php/$version/mods-available/sqlsrv.ini" \
        && echo 'extension=pdo_sqlsrv.so' > "/etc/php/$version/mods-available/pdo_sqlsrv.ini" \
        && phpenmod -v "$version" sqlsrv pdo_sqlsrv \
        || exit 1; \
    done

# Install composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# we need en_US locales for MSSQL connection to work
# we need en_AU locales for behat to work
# Extra locales allow testing non-English and RTL formatting
RUN for locale in \
        en_US.UTF-8 \
        en_AU.UTF-8 \
        de_DE.UTF-8 \
        fr_FR.UTF-8 \
        es_ES.UTF-8 \
        ar_AE.UTF-8 \
        he_IL.UTF-8; \
    do \
        sed -i -e "s/# ${locale} UTF-8/${locale} UTF-8/" /etc/locale.gen; \
    done && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN echo 'export PATH="$PATH:/opt/mssql-tools18/bin"' >> ~/.bash_profile \
    && echo 'export PATH="$PATH:/opt/mssql-tools18/bin"' >> ~/.bashrc

RUN ln -fs /usr/share/zoneinfo/${TIME_ZONE} /etc/localtime \
    && dpkg-reconfigure --frontend noninteractive tzdata

# Python 3 for ML Recommender.
RUN apt-get update && apt-get install -y python3 \
    python3-pip \
    python3-wheel \
    python3-venv \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Source each .sh file found in the /shell/ folder, always source the default_aliases.sh file first
RUN echo 'if [[ -e "/root/custom_shell/default-aliases.sh" ]]; then source "/root/custom_shell/default-aliases.sh"; fi' >> ~/.bashrc && \
  echo 'for f in /root/custom_shell/*.sh; do [[ "$f" != "/root/custom_shell/default-aliases.sh" && -e "$f" ]] && source "$f"; done;' >> ~/.bashrc

# Have the option of using the oh my zsh shell.
RUN apt-get update && apt-get install -y zsh && rm -rf /var/lib/apt/lists/*
RUN sh -c "$(curl https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" --unattended
RUN git clone https://github.com/romkatv/powerlevel10k ~/.oh-my-zsh/custom/themes/powerlevel10k
RUN git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
RUN git clone https://github.com/zsh-users/zsh-completions ~/.oh-my-zsh/custom/plugins/zsh-completions
RUN git clone https://github.com/zsh-users/zsh-syntax-highlighting ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting
RUN echo 'setopt +o nomatch' > ~/.zshrc
RUN echo 'source ~/custom_shell/.zshrc' >> ~/.zshrc
RUN cat ~/.bashrc >> ~/.zshrc

# Distrust the eMudhra (emSign) root CAs and Sectigo's AAA Certificate Services root. In October 2026
# the private keys of six eMudhra TLS intermediate CAs were found to be trivially recoverable. They were
# issued by emSign Root TLS CA - G3, which chains to emSign ECC Root CA - G3, and were cross-signed by
# AAA Certificate Services. Older Debian CA bundles still trust both roots, and PHP and curl do not check
# revocation. The other emSign roots are distrusted as a precaution. Where an entry is absent this
# changes nothing. The build fails if any of these roots is still in the trusted bundle afterwards, or if
# the bundle cannot be read.
RUN sed -i -E 's#^(mozilla/emSign_.*|mozilla/Comodo_AAA_Services_root\.crt)$#!\1#' /etc/ca-certificates.conf \
    && update-ca-certificates --fresh \
    && openssl crl2pkcs7 -nocrl -certfile /etc/ssl/certs/ca-certificates.crt \
        | openssl pkcs7 -print_certs -noout > /tmp/ca-subjects \
    && grep -q '^subject=' /tmp/ca-subjects \
    && ! grep -qE '^subject=.*(emSign|AAA Certificate Services)' /tmp/ca-subjects \
    && rm /tmp/ca-subjects

# Every version has to pass the smoke test. The last one selected is the default when no PHP_VERSION is set.
COPY smoke-test.sh /usr/local/bin/totara-php-smoke-test
RUN chmod +x /usr/local/bin/totara-php-smoke-test \
    && for version in $PHP_VERSIONS; do \
        echo "Smoke testing PHP $version" \
        && totara-php-select "$version" \
        && /usr/local/bin/totara-php-smoke-test \
        || exit 1; \
    done

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT [ "/entrypoint.sh" ]
